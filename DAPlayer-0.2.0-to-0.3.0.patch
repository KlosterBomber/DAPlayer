+        List<String> entries = new ArrayList<>();
+        for (String line : raw) {
+            line = line.strip();
+            if (line.startsWith("﻿")) {line = line.substring(1);}
+            if (line.isEmpty() || line.startsWith("#")) {continue;}
+            if (Track.isUrl(line)) {
