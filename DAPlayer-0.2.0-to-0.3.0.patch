+        if (track.getArtist() == null) {track.setArtist(dictValue(dict, "artist"));}
+        if (track.getAlbum() == null) {track.setAlbum(dictValue(dict, "album"));}
+        if (track.getAlbumArtist() == null) {track.setAlbumArtist(dictValue(dict, "album_artist"));}
